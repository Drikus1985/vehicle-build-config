{
  "name": "vehicle-build-config",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive vehicle build configurator for American classics, muscle cars and trucks (1948-1978), with Titanforge fabrication workflow.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src scripts",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:demo-vehicle": "node scripts/generate-demo-vehicle.mjs",
    "generate:nova-addons": "node scripts/generate-nova-addons.mjs",
    "compress:nova": "node scripts/compress-glb.mjs public/assets/vehicles/nova-1970.glb && node scripts/compress-glb.mjs public/assets/vehicles/nova-1970-uv.glb"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "idb": "^8.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0",
    "zod": "^3.24.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}
